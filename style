:root{
  --navy:#071426;--navy2:#0b1d34;--navy3:#102746;
  --gold:#d9a441;--gold2:#f1c96a;--white:#fff;
  --text:#edf3fa;--muted:#b7c4d5;--line:rgba(255,255,255,.10);
  --card:rgba(255,255,255,.055);--max:1180px;--radius:22px
}
*{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:90px}
body{margin:0;font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",Arial,sans-serif;color:var(--text);background:var(--navy);line-height:1.7}
a{color:inherit;text-decoration:none}
img{display:block;max-width:100%;height:auto}
.container{width:min(calc(100% - 40px),var(--max));margin:auto}
header{position:sticky;top:0;z-index:100;background:rgba(7,20,38,.92);backdrop-filter:blur(16px);border-bottom:1px solid var(--line)}
.nav{min-height:76px;display:flex;align-items:center;justify-content:space-between;gap:24px}
.brand{display:flex;align-items:center;gap:12px;font-weight:850;letter-spacing:.1em;white-space:nowrap}
.brand img{width:42px;height:42px;object-fit:contain;border-radius:9px}
.brand span{font-size:15px}.brand b{color:var(--gold2)}
nav{display:flex;align-items:center;gap:22px}
nav a{color:#dbe4ef;font-size:14px;font-weight:650}
nav a:hover{color:var(--gold2)}
.nav-cta{padding:9px 16px;border:1px solid rgba(217,164,65,.55);border-radius:999px;color:var(--gold2)!important}
.hero{position:relative;overflow:hidden;padding:120px 0 105px;background:radial-gradient(circle at 82% 28%,rgba(217,164,65,.18),transparent 28%),radial-gradient(circle at 18% 75%,rgba(35,89,145,.25),transparent 32%),linear-gradient(135deg,#071426,#0b1b31 58%,#121e31)}
.hero-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:70px;align-items:center}
.eyebrow{display:inline-flex;align-items:center;gap:10px;color:var(--gold2);font-size:12px;font-weight:850;letter-spacing:.16em;text-transform:uppercase;margin-bottom:18px}
.eyebrow:before{content:"";width:36px;height:1px;background:var(--gold)}
h1{font-size:clamp(44px,6vw,76px);line-height:1.04;letter-spacing:-.045em;margin:0 0 24px}
h1 span{color:var(--gold)}
.hero p,.lead{color:var(--muted);font-size:18px;max-width:720px}
.actions{display:flex;flex-wrap:wrap;gap:14px;margin-top:30px}
.btn{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 22px;border-radius:10px;font-weight:800;border:1px solid transparent}
.btn-primary{color:#111;background:linear-gradient(135deg,var(--gold2),var(--gold));box-shadow:0 12px 30px rgba(217,164,65,.18)}
.btn-secondary{border-color:rgba(255,255,255,.18);background:rgba(255,255,255,.035)}
.hero-card,.card,.legal-card{border:1px solid var(--line);background:var(--card);border-radius:var(--radius)}
.hero-card{padding:34px;box-shadow:0 30px 80px rgba(0,0,0,.25)}
.hero-logo{width:180px;margin:0 auto 26px;border-radius:18px}
section{padding:95px 0}
.dark{background:#09182c}
.section-head{max-width:800px;margin-bottom:42px}
.section-title{font-size:clamp(34px,4vw,52px);line-height:1.1;letter-spacing:-.035em;margin:0 0 16px}
.muted{color:var(--muted)}
.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.card{padding:30px}
.icon{width:48px;height:48px;display:grid;place-items:center;border-radius:14px;background:rgba(217,164,65,.11);color:var(--gold2);font-weight:850;margin-bottom:20px}
.card h3{margin:0 0 10px;font-size:21px}.card p{margin:0;color:var(--muted);font-size:15px}
.page-hero{padding:90px 0 65px;background:linear-gradient(135deg,#071426,#102746)}
.page-hero h1{font-size:clamp(40px,5vw,64px)}
.content{max-width:900px}
.content h2{margin-top:42px;font-size:30px}
.content h3{margin-top:28px;font-size:21px}
.content p,.content li{color:var(--muted)}
.content ul{padding-left:22px}
.legal-card{padding:34px}
.contact-grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:24px}
.info-list{display:grid;gap:14px}
.info{padding:20px;border:1px solid var(--line);border-radius:16px;background:var(--card)}
.info strong{display:block;color:#fff;margin-bottom:4px}
.form{display:grid;gap:14px}
label{font-weight:700;font-size:14px}
input,textarea{width:100%;border:1px solid var(--line);background:#071426;color:#fff;border-radius:10px;padding:13px 14px;font:inherit}
textarea{min-height:150px;resize:vertical}
footer{padding:42px 0;background:#050e1b;color:#9eabbc}
.footer{display:flex;justify-content:space-between;gap:25px}
.footer-links{display:flex;flex-wrap:wrap;gap:16px}
.footer strong{color:#fff}.copyright{font-size:13px}
.notice{padding:16px 18px;border-left:3px solid var(--gold);background:rgba(217,164,65,.07);color:var(--muted);margin:20px 0}
@media(max-width:850px){nav{display:none}.hero-grid,.contact-grid{grid-template-columns:1fr;gap:40px}.grid3{grid-template-columns:1fr}.footer{flex-direction:column}}
@media(max-width:520px){.container{width:min(calc(100% - 28px),var(--max))}.brand span{font-size:13px}section{padding:72px 0}.hero{padding:90px 0}.hero-card,.legal-card,.card{padding:24px}}
